# Media and binary formats (MUST NEVER BE COMMITTED EXCEPT SYNTHETIC FIXTURES)
*.mp3
*.m4a
*.flac
*.wav
*.aac
*.ogg
*.opus
*.wma
*.alac
*.ape
*.jpg
*.jpeg
*.png
*.gif

# Explicitly allow synthetic test fixtures
!tests/fixtures/*.wav
!tests/fixtures/*.mp3
!tests/fixtures/*.m4a

# Database files
*.sqlite
*.sqlite3
*.db

# Sensitive files & credentials
.env
.env.*
credentials*
secrets*
tokens*
*.pem
*.key

# Runtime working directories & logs
/quarantine/
/backups/
/staging/
/engineering-log/
*.lock
